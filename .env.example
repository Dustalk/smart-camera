# Gemini API key used server-side by the Vercel Functions in /api.
# This single key powers both endpoints and must NEVER reach the browser:
# /api/live-token only hands the client a short-lived ephemeral token.
GEMINI_API_KEY=

# Model names, prices and thinking level are DEFINED IN api/_models.ts — the one
# file in this repo allowed to spell them out (Platform/docs/decisions/002).
# The variables below only OVERRIDE those defaults; production runs on the
# committed defaults. `npm run models` prints what each task resolves to.
#
#   GEMINI_MODEL                 refine-items primary  (default gemini-3.8-flash)
#   GEMINI_FALLBACK_MODEL        refine-items fallback (default gemini-3.6-flash)
#   GEMINI_THINKING_LEVEL        low | medium | high | auto (default low)
#   GEMINI_LIVE_MODEL            talk-mode primary
#   GEMINI_LIVE_FALLBACK_MODEL   talk-mode fallback
#
# gemini-3.8-flash does NOT support the Live API (no native audio), so talk mode
# uses the dedicated gemini-3.8-live model instead.
